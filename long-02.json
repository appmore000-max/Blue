   "text": "五點十分，他起來。",
   "pause_before": 2
  },
  {
   "t": "narration",
   "text": "洗臉。",
   "pause_before": 1
  },
  {
   "t": "narration",
   "text": "燒水。",
   "pause_before": 0
  },
  {
