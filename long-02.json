{
 "id": "長篇_02_二十七秒",
 "title": "第二章｜二十七秒",
 "boxes": [
  {
   "t": "narration",
   "text": "三月十一號，星期二。",
   "pause_before": 1
  },
  {
   "t": "narration",
   "text": "而余冷川那天四點五十醒。",
   "pause_before": 0
  },
  {
   "t": "narration",
   "text": "而那不是他排的。",
   "pause_before": 1
  },
  {
   "t": "emphasis",
   "text": "那個時間他自己就會醒。",
   "pause_before": 0
  },
  {
