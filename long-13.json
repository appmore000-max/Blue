   "text": "「早。」",
   "pause_before": 1,
   "who": "wife",
   "label_as": null
  },
  {
   "t": "narration",
   "text": "而她說：「你要吃什麼。」",
   "pause_before": 2
  },
  {
   "t": "narration",
   "text": "而他說：「都可以。」",
