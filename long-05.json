   "who": "chen_wenbin",
   "label_as": null
  },
  {
   "t": "narration",
   "text": "而那個醫生那一秒抬起頭了。",
   "pause_before": 3
  },
  {
   "t": "narration",
   "text": "而他看了陳文彬一眼。",
