  },
  {
   "t": "narration",
   "text": "而打字的時候他說了一句。",
   "pause_before": 3
  },
  {
   "t": "speech",
   "text": "「我開個檢查。」",
   "pause_before": 2,
   "who": "neuro_doc",
   "label_as": null
  },
  {
