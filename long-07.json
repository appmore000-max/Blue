 "boxes": [
  {
   "t": "narration",
   "text": "六月十七號，星期二。",
   "pause_before": 1
  },
  {
   "t": "narration",
   "text": "而那天陳文彬回家的時候是六點多。",
   "pause_before": 0
  },
  {
   "t": "emphasis",
   "text": "而那比平常早。",
